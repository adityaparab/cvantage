{
  "name": "cvantage",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "db:up": "docker compose --env-file deploy/local/compose.env -f deploy/local/compose.yaml up -d --wait --wait-timeout 120",
    "db:down": "docker compose --env-file deploy/local/compose.env -f deploy/local/compose.yaml down",
    "db:logs": "docker compose --env-file deploy/local/compose.env -f deploy/local/compose.yaml logs -f mongodb",
    "install:all": "yarn install && yarn --cwd client install",
    "dev": "concurrently -k -n api,web -c blue,green \"yarn dev:server\" \"yarn dev:client\"",
    "dev:server": "nest start --watch",
    "dev:client": "yarn --cwd client dev",
    "build": "yarn build:client && yarn build:server",
    "build:server": "nest build",
    "build:client": "yarn --cwd client build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "yarn build:client",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node scripts/test-database.cjs",
    "test:browser": "yarn build && node scripts/test-browser.cjs",
    "test:models": "yarn build:server && node scripts/smoke-models.cjs"
  },
  "dependencies": {
    "@langchain/core": "^1",
    "@langchain/langgraph": "^1",
    "@langchain/openai": "^1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.5",
    "ajv": "^8.20.0",
    "docx": "^9.7.1",
    "fontkit": "^2.0.4",
    "mammoth": "^1.12.3",
    "mongodb": "^7.6.0",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "word-extractor": "^1.0.4",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.0.0",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=24"
  }
}
