NODE_ENV=development
PORT=3000
# Local Docker Compose: yarn db:up (deploy/local/README.md).
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=cvantage&directConnection=true
MONGODB_DATABASE=cvantage
# Generate a unique random value of at least 32 characters.
SESSION_SECRET=
LITELLM_BASE_URL=https://aigateway.adityaparab.info/v1
LITELLM_API_KEY=
LITELLM_WORKER_MODEL=
LITELLM_JUDGE_MODEL=

# Single-font TTF/OTF with glyph coverage for PDF exports.
EXPORT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
